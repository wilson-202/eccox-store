                            <path fill="#FF3D00"
                                d="m6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691" />
                            <path fill="#4CAF50"
                                d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.9 11.9 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44" />
                            <path fill="#1976D2"
                                d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917" />
                        </svg>
                    </button>
                    <button
                        class="w-full bg-stone-600 capitalize text-white rounded-xl h-10 flex justify-center items-center gap-2.5">
                        <svg class="size-6" xmlns="http://www.w3.org/2000/svg" width="256" height="256"
                            viewBox="0 0 256 256">
                            <path d="M0 0h256v256H0z" fill="none" />
                            <path fill="#1877f2"
                                d="M256 128C256 57.308 198.692 0 128 0S0 57.308 0 128c0 63.888 46.808 116.843 108 126.445V165H75.5v-37H108V99.8c0-32.08 19.11-49.8 48.348-49.8C170.352 50 185 52.5 185 52.5V84h-16.14C152.959 84 148 93.867 148 103.99V128h35.5l-5.675 37H148v89.445c61.192-9.602 108-62.556 108-126.445" />
                            <path fill="#fff"
                                d="m177.825 165l5.675-37H148v-24.01C148 93.866 152.959 84 168.86 84H185V52.5S170.352 50 156.347 50C127.11 50 108 67.72 108 99.8V128H75.5v37H108v89.445A129 129 0 0 0 128 256a129 129 0 0 0 20-1.555V165z" />
                        </svg>


                    </button>
                    <button
                        class="w-full bg-stone-600 text-white rounded-xl h-10 flex justify-center items-center gap-2.5 capitalize">
                        <svg class="size-6" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                            viewBox="0 0 16 16">
                            <path d="M0 0h16v16H0z" fill="none" />
                            <defs>
                                <path id="SVG67go7b2R"
                                    d="M11.182.008C11.148-.03 9.923.023 8.857 1.18c-1.066 1.156-.902 2.482-.878 2.516s1.52.087 2.475-1.258s.762-2.391.728-2.43m3.314 11.733c-.048-.096-2.325-1.234-2.113-3.422s1.675-2.789 1.698-2.854s-.597-.79-1.254-1.157a3.7 3.7 0 0 0-1.563-.434c-.108-.003-.483-.095-1.254.116c-.508.139-1.653.589-1.968.607c-.316.018-1.256-.522-2.267-.665c-.647-.125-1.333.131-1.824.328c-.49.196-1.422.754-2.074 2.237c-.652 1.482-.311 3.83-.067 4.56s.625 1.924 1.273 2.796c.576.984 1.34 1.667 1.659 1.899s1.219.386 1.843.067c.502-.308 1.408-.485 1.766-.472c.357.013 1.061.154 1.782.539c.571.197 1.111.115 1.652-.105c.541-.221 1.324-1.059 2.238-2.758q.52-1.185.473-1.282" />
                            </defs>
                            <g fill="currentColor">
                                <use href="#SVG67go7b2R" />
                                <use href="#SVG67go7b2R" />
                            </g>
                        </svg>
                       

                    </button>
                </div>
                <div class="flex border-t gap-4 flex-col justify-center items-center w-full  border-stone-700">
                    <p class="capitalize text-stone-200 px-3  -translate-y-3.5 bg-black">or</p>
                    <div class="w-full relative h-fit">
                        <input type="email" name=""
                            class="w-full placeholder:font-medium text-white placeholder:capitalize pl-12 pr-3 placeholder:text-stone-400 rounded-2xl h-11 focus:outline-none focus:border-fuchsia-500  focus:border-2  bg-stone-800"
                            id="loginEmail" placeholder="enter your email">
                        <svg class="size-6 left-[3%] top-[25%] text-stone-400 absolute"
                            xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48">
                            <path d="M0 0h48v48H0z" fill="none" />
                            <path fill="currentColor"
                                d="M10.25 8A6.25 6.25 0 0 0 4 14.25v19.5A6.25 6.25 0 0 0 10.25 40h27.5A6.25 6.25 0 0 0 44 33.75v-19.5A6.25 6.25 0 0 0 37.75 8zM6.5 14.25a3.75 3.75 0 0 1 3.75-3.75h27.5a3.75 3.75 0 0 1 3.75 3.75v.89l-17.498 9.21L6.5 15.063zm0 3.644l16.914 8.974a1.25 1.25 0 0 0 1.168.002L41.5 17.965V33.75a3.75 3.75 0 0 1-3.75 3.75h-27.5a3.75 3.75 0 0 1-3.75-3.75z" />
                        </svg>

                    </div>

                    <div class="w-full relative h-fit">
                        <input type="password" id="loginPassword"
                            class="w-full placeholder:font-medium text-white placeholder:capitalize pl-12 pr-3 placeholder:text-stone-400 rounded-2xl h-11 focus:outline-none focus:border-fuchsia-500  focus:border-2  bg-stone-800"
                            placeholder="password">
                        <svg class="size-5 left-[3%] top-[25%] text-stone-400 absolute"
                            xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                            <path d="M0 0h16v16H0z" fill="none" />
                            <path fill="currentColor" fill-rule="evenodd"
                                d="M8 0a4 4 0 0 1 4 4v2.05a2.5 2.5 0 0 1 2 2.45v5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 13.5v-5a2.5 2.5 0 0 1 2-2.45V4a4 4 0 0 1 4-4M4.5 7A1.5 1.5 0 0 0 3 8.5v5A1.5 1.5 0 0 0 4.5 15h7a1.5 1.5 0 0 0 1.5-1.5v-5A1.5 1.5 0 0 0 11.5 7zM8 1a3 3 0 0 0-3 3v2h6V4a3 3 0 0 0-3-3" />
                        </svg>

                        <div id="passEyeToggleForLogin"
                            class=" absolute z-10 w-fit h-fit text-stone-500 right-[3%] active:scale-80 transition-all duration-200 top-[23%]">


                            <svg id="onHidePassLogin" class="size-6 block" xmlns="http://www.w3.org/2000/svg" width="24"
                                height="24" viewBox="0 0 24 24">
                                <path d="M0 0h24v24H0z" fill="none" />
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M2 12C3.0523 7.3229 7.206 4 12 4C16.794 4 20.9477 7.3229 22 12C20.9477 16.6771 16.794 20 12 20C7.206 20 3.0523 16.6771 2 12ZM15 12C15 13.6569 13.6569 15 12 15C10.3431 15 9 13.6569 9 12C9 10.3431 10.3431 9 12 9C13.6569 9 15 10.3431 15 12Z" />
                            </svg>

                            <svg id="onShowPassLogin" class="size-6 hidden" xmlns="http://www.w3.org/2000/svg"
                                width="24" height="24" viewBox="0 0 24 24">
                                <path d="M0 0h24v24H0z" fill="none" />
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M18.035 18.035C16.3283 19.2786 14.2337 20 12 20C7.206 20 3.0523 16.6771 2 12C2.562 9.5021 4.0086 7.3904 5.965 5.965M9.8779 4.2211C10.565 4.076 11.2752 4 12 4C16.794 4 20.9477 7.3229 22 12C21.7487 13.1169 21.3206 14.1566 20.7491 15.0922M14.1213 14.1213C13.5785 14.6642 12.8285 15 12 15C10.3431 15 9 13.6569 9 12C9 11.1716 9.3358 10.4216 9.8787 9.8787M2 2L22 22" />
                            </svg>

                        </div>


                    </div>

                    <button
                        class="w-full h-11 bg-fuchsia-600 shadow-inner shadow-fuchsia-900 rounded-xl text-white active:scale-90 transition-all duration-200 font-semibold uppercase">login</button>
                </div>
            </form>
            <div id="forLoginFoot"
                class="border-t w-full border-stone-600 flex flex-col  gap-2.5 justify-center items-center pt-4 ">
                <p class="text-fuchsia-600 font-mono capitalize font-semibold"><a href="/forgot-password">forgot password?</a></p>
                <div class="flex gap-1.5">
                    <p class="capitalize text-stone-100 text-sm font-medium">don't have an account ?</p>
                    <a href="/signup" class="text-fuchsia-600 font-semibold text-sm font-mono capitalize">sign up here</button>
                </div>
            </div>
        </section>
    </main>

    <script>

        const forLoginFoot = document.getElementById('forLoginFoot')
        const onShowPassLogin = document.getElementById('onShowPassLogin')
        const onHidePassLogin = document.getElementById('onHidePassLogin')
        const passEyeToggleForLogin = document.getElementById('passEyeToggleForLogin')
        const loginEmail = document.getElementById('loginEmail')
        const loginPassword = document.getElementById('loginPassword')
        const loginForm = document.getElementById('loginForm')


        // =========login input regex ============
        loginEmail.addEventListener('input', function () {
            this.value = this.value
                .replace(/[^a-zA-Z0-9.@_-]/g, '')
        })

        loginPassword.addEventListener('input', function () {
            this.value = this.value
                .replace(/[^a-zA-Z0-9@#$]/g, '')
        })

        // ===== loginbox eye toggle =====
        passEyeToggleForLogin.addEventListener('click', () => {
            if (onHidePassLogin.classList.contains('block')) {
                onHidePassLogin.classList.replace('block', 'hidden')
                onShowPassLogin.classList.replace('hidden', 'block')
                loginPassword.type = 'text'
            } else {
                onShowPassLogin.classList.replace('block', 'hidden')
                onHidePassLogin.classList.replace('hidden', 'block')
                loginPassword.type = 'password'

            }
        })
                const messageBox =  document.getElementById('messageBox')

        const messageText = document.getElementById('messageText')
        const messageTextCont = document.getElementById('messageTextCont')
        const closeToastError = document.getElementById('closeToastError')

        loginForm.addEventListener('submit', async (event) => {
            event.preventDefault()
            const payLoad = {
                email: loginEmail.value,
                password: loginPassword.value
            }

            const response = await fetch('/login-post', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payLoad)
            })
            const errorJson = await response.json()
            console.log(errorJson)

            if (!response.ok) {
                const errorCode = response.status;

                messageBox.classList.replace('tran', 'translate-x-0')
                messageTextCont.classList.remove('bg-green-600', 'shadow-green-600')
                closeToast()
                const clearmessage = errorJson.error || errorJson.errors[0].replace(/['"]/g, '')
                messageText.innerText = clearmessage
            } else {
                window.location = '/'

            }
        })
        closeToastError.addEventListener('click', () => {
            messageBox.classList.replace('translate-x-0', 'tran')

        })
        function closeToast() {
            setTimeout(() => {
                messageBox.classList.replace('translate-x-0', 'tran')
            }, 6000)
        }

    </script>
</body>

</html>