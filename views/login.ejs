    <script>

        const forLoginFoot = document.getElementById('forLoginFoot')
        const onShowPassLogin = document.getElementById('onShowPassLogin')
        const onHidePassLogin = document.getElementById('onHidePassLogin')
        const passEyeToggleForLogin = document.getElementById('passEyeToggleForLogin')
        const loginEmail = document.getElementById('loginEmail')
        const loginPassword = document.getElementById('loginPassword')
        const loginForm = document.getElementById('loginForm')
        const loginEmailSmError = document.getElementById('loginEmailSmError')
        const loginEmailSvg = document.getElementById('loginEmailSvg')
        const loginPassSmError = document.getElementById('loginPassSmError')
        const loginPassSvg = document.getElementById('loginPassSvg')
        const loginPassCont = document.getElementById('loginPassCont')


        // =========login input regex ============
        loginEmail.addEventListener('input', function () {
            if (loginEmail.classList.contains('border-red-500')) {
                loginEmail.classList.replace('border-red-500', 'border-black')
                loginEmail.classList.replace('placeholder:text-red-500', 'placeholder:text-stone-400')
            }
            if (loginEmailSmError.classList.contains('block')) {
                loginEmailSmError.classList.replace('block', 'hidden')
            }
            if (loginEmailSvg.classList.contains('text-red-500')) {
                loginEmailSvg.classList.replace('text-red-500', 'text-black')

            }
            this.value = this.value
                .replace(/[^a-zA-Z0-9.@_-]/g, '')
        })

        loginPassword.addEventListener('input', function () {
            if (loginPassword.classList.contains('border-red-500')) {
                loginPassword.classList.replace('border-red-500', 'border-black')
                loginPassword.classList.replace('placeholder:text-red-500', 'placeholder:text-stone-400')

            }
            if (loginPassSmError.classList.contains('block')) {
                loginPassSmError.classList.replace('block', 'hidden')
            }
            if (loginPassSvg.classList.contains('text-red-500')) {
                loginPassSvg.classList.replace('text-red-500', 'text-black')

            }
            loginPassCont.classList.replace('justify-between', 'justify-end')
        })

        // ===== loginbox eye toggle =====
        passEyeToggleForLogin.addEventListener('click', () => {
            if (onHidePassLogin.classList.contains('block')) {
                onHidePassLogin.classList.replace('block', 'hidden')
                onShowPassLogin.classList.replace('hidden', 'block')
                loginPassword.type = 'text'
            } else {
                onShowPassLogin.classList.replace('block', 'hidden')
                onHidePassLogin.classList.replace('hidden', 'block')
                loginPassword.type = 'password'

            }
        })
        const messageBox = document.getElementById('messageBox')

        const messageText = document.getElementById('messageText')
        const messageTextCont = document.getElementById('messageTextCont')
        const closeToastError = document.getElementById('closeToastError')
        const loginBtn = document.getElementById('loginBtn')
        loginForm.addEventListener('submit', async (event) => {
            event.preventDefault()
            loginBtn.textContent = '....'
            const payLoad = {
                email: loginEmail.value,
                password: loginPassword.value
            }

            try {
                const response = await fetch('/login-post', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payLoad)
                })
                const errorJson = await response.json()
                console.log(errorJson)

                if (response.status === 400) {

                    const clearmessage = errorJson.error || errorJson.errors[0].replace(/['"]/g, '')
                    console.log(errorJson.errors.email)
                    messageBox.classList.replace('tran', 'translate-x-0')
                    messageTextCont.classList.remove('bg-green-600', 'shadow-green-600')
                    closeToast()
                    messageText.innerText = clearmessage



                    if (loginEmail.classList.contains('border-black')) {
                        loginEmail.classList.remove('border-black', 'placeholder:text-stone-400')
                        loginEmail.classList.add('border-red-500', 'placeholder:text-red-500')
                        setTimeout(() => {
                            loginEmail.classList.add('shake2')
                            setTimeout(() => {
                                loginEmail.classList.remove('shake2')
                            }, 600)
                        }, 100)
                    }
                    // loginEmailSmError.classList.replace('hidden', 'block')
                    // loginEmailSmError.textContent = clearmessage
                    loginEmailSvg.classList.replace('text-black', 'text-red-500')



                    if (loginPassword.classList.contains('border-black')) {
                        loginPassword.classList.remove('border-black', 'placeholder:text-stone-400')
                        loginPassword.classList.add('border-red-500', 'placeholder:text-red-500')
                        setTimeout(() => {
                            loginPassword.classList.add('shake2')
                            setTimeout(() => {
                                loginPassword.classList.remove('shake2')
                            }, 600)
                        }, 100)
                    }
                    // loginPassSmError.classList.replace('hidden', 'block')
                    // loginPassSmError.textContent = clearmessage
                    loginPassSvg.classList.replace('text-black', 'text-red-500')




                }

                if (response.status === 401) {
                    const clearmessage = errorJson.error || errorJson.errors[0].replace(/['"]/g, '')

                    if (errorJson.error === 'Invalid Email') {
                        if (loginEmail.classList.contains('border-black')) {
                            loginEmail.classList.remove('border-black')
                            loginEmail.classList.add('border-red-500')
                        }
                        loginEmailSmError.classList.replace('hidden', 'block')
                        loginEmailSmError.textContent = clearmessage
                        loginEmailSvg.classList.replace('text-black', 'text-red-500')


                        setTimeout(() => {
                            loginEmail.classList.add('shake2')
                            setTimeout(() => {
                                loginEmail.classList.remove('shake2')
                            }, 600)
                        }, 100)
                    }



                    // ======= for incorrect password =========

                    if (errorJson.error === 'Incorrect Password') {
                        if (loginPassword.classList.contains('border-black')) {
                            loginPassword.classList.remove('border-black')
                            loginPassword.classList.add('border-red-500')
                        }
                        loginPassSmError.classList.replace('hidden', 'block')
                        loginPassSmError.textContent = clearmessage
                        loginPassSvg.classList.replace('text-black', 'text-red-500')
                        loginPassCont.classList.replace('justify-end', 'justify-between')
                        setTimeout(() => {
                            loginPassword.classList.add('shake2')
                            loginPassword.value = ''
                            setTimeout(() => {
                                loginPassword.classList.remove('shake2')
                            }, 300)
                        }, 400)
                    }
                }
                if (response.status === 403) {
                    window.location = `/verify-email?email=${loginEmail.value}`
                }
                if (response.ok) {
                    window.location = '/'
                }
            } catch (error) {
                console.log(error)
            }

            finally {
                loginBtn.innerHTML = ` <p>Sign In</p>
                        <svg class="text-white size-6.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                            viewBox="0 0 24 24">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2">
                                <path
                                    d="M9 6c.047-1.093.185-1.79.597-2.326q.242-.313.555-.554c.81-.62 1.985-.62 4.335-.62h.501c2.834 0 4.251 0 5.132.879c.88.878.88 2.293.88 5.121v7c0 2.828 0 4.243-.88 5.121s-2.298.879-5.132.879h-.5c-2.351 0-3.526 0-4.336-.62a3 3 0 0 1-.554-.554C9.185 19.79 9.047 19.093 9 18" />
                                <path d="M15 12H3m9.5 3.5S16 12.922 16 12s-3.5-3.5-3.5-3.5" />
                            </g>
                        </svg>`
            }

        })
        closeToastError.addEventListener('click', () => {
            messageBox.classList.replace('translate-x-0', 'tran')

        })
        function closeToast() {
            setTimeout(() => {
                messageBox.classList.replace('translate-x-0', 'tran')
            }, 6000)
        }

        const signInWith = document.getElementById('signInWith')


    </script>
