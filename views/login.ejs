                </svg>


            </div>
        </div>
        <section class="w-[50%] h-full relative rounded-l-4xl">
            <img src="/wmremove-transformed (1).jpeg"
                class="absolute h-full w-full rounded-l-4xl inset-0 object-cover object-right " alt="">
            <div class=" flex flex-col gap-3 absolute w-full z-10 h-[20%] bottom-0 px-[10%]">
                <h1 class="text-4xl text-white font-bold capitalize">upgrade your reality</h1>
                <p class="text-white">Discover next-gen premium products engineered for tomorrow</p>

            </div>
            <div class="flex z-12 absolute top-[5%] left-[5%] items-center gap-3.5">
                <svg class="text-stone-100  size-10" xmlns="http://www.w3.org/2000/svg" width="8" height="8"
                    viewBox="0 0 8 8">
                    <path d="M0 0h8v8H0z" fill="none" />
                    <path fill="currentColor"
                        d="M8 5Q5 6 4 8Q3 6 0 5l1-2l-1-3l3 2h2l3-2l-1 3M2 3l1 1V3m2 0v1l1-1M1 5q2 1 3 2q1-1 3-2M4 6l1-1l-1-1l-1 1" />
                </svg>
                <p class="font-bold capitalize text-white text-lg">eccox store</p>
            </div>

            <div class="absolute right-0 h-full w-[10%] bg-linear-to-l z-13 via-black/60 from-black to-transparent">
            </div>
            <div
                class="bg-linear-to-t rounded-l-4xl from-black/90 to-transparent from-30% absolute w-full h-[30%] bottom-0 z-8">
            </div>
            <div
                class="bg-linear-to-b rounded-l-4xl from-black/80 to-transparent from-30% absolute w-full h-[20%] top-0-0 z-8">
            </div>
        </section>
        <section class="w-[50%] h-full rounded-r-4xl gap-5 flex justify-center items-center flex-col border bg-black">
            <div class="w-fit flex items-center justify-center p-1 rounded-2xl bg-stone-800">

            </div>
            <h1 id="topText" class="capitalize text-3xl text-gray-100 font-medium">login to your account</h1>
            <form id="loginForm" class="w-[60%] flex flex-col gap-4">
                <div class="flex  gap-4">

                    <button
                        class="w-full bg-stone-600 text-white rounded-xl h-10 flex justify-center items-center gap-2.5">
                        <svg class="size-6" xmlns="http://www.w3.org/2000/svg" width="48" height="48"
                            viewBox="0 0 48 48">
                            <path d="M0 0h48v48H0z" fill="none" />
                            <path fill="#FFC107"
