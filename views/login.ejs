<!doctype html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="output.css" rel="stylesheet">
    <title> </title>
</head>

<body class="h-dvh w-full">
    <main class="h-full font-custom2 bg-stone-700 max-md:bg-white overflow-hidden w-full md:flex relative">
        <section class="w-[50%] loginleftBG max-md:hidden h-full relative ">
            <div class=" flex gap-1.5 absolute w-full z-10 h-[20%] bottom-0 items-center px-[5%]">
                <h1 class="text-5xl text-black font-custom2 text-nowrap font-extrabold capitalize">upgrade your
                    reality..
                </h1>
            </div>
            <div class="flex z-12 absolute top-[5%] left-[5%] items-center gap-3.5">
                <div class="flex justify-start max-md:hidden  px-[5%] h-fit w-fit items-center">
                    <div class="flex-center bg-white shadow-inner shadow-gray-300  w-fit h-fit  rounded-xl ">
                        <svg class="text-black  size-10" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                            viewBox="0 0 24 24">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2.5" d="M14 8h-4v8h4m-4-4h2.5" />
                        </svg>


                    </div>
                </div>
                <p class="font-bold capitalize text-nowrap font-custom2 text-white text-lg">eccox store</p>
            </div>
        </section>
        <section
            class="md:w-[50%] max-md:h-[85%] w-full h-full md:px-[6%] md:gap-3.5 max-md:gap-5 flex justify-center items-center  flex-col  bg-white ">

            <div class="flex justify-start md:hidden px-[5%] h-fit w-full items-center">
                <div
                    class="flex-center bg-linear-to-tl from-indigo-500 to-gray-300 via-fuchsia-700  w-fit h-fit  rounded-xl ">
                    <svg class="text-white size-10" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                        viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                            stroke-width="2.5" d="M14 8h-4v8h4m-4-4h2.5" />
                    </svg>
                </div>
            </div>
            <div class=" w-full flex flex-col gap-2 px-[5%]">
                <h1 id="topText" class="capitalize font-custom2  w-full  text-3xl text-black text-start   font-bold ">
                    Sign in to your eccox account</h1>
                <p class="hidden md:block font-custom2 font-medium text-stone-600">Let's get you signed in so you can
                    check out your cart.</p>
            </div>
            <form id="loginForm" class="md:w-[90%] w-full flex flex-col md:gap-2 max-md:gap-4">

                <div class="flex  md:gap-4 gap-3 flex-col justify-center items-center w-full  border-stone-700">
                    <!-- <p class="capitalize text-stone-200 px-3  max-md:hidden -translate-y-3.5 bg-black">or</p> -->
                    <div class="h-fit md:w-full w-[90%]">
                        <label for="email"
                            class="capitalize  md:translate-y-[60%] text-lg text-black  w-full px-[2%] max-md:px-[5%]">email
                            address</label>
                        <div class="w-full   relative  h-fit">
                            <input type="email" name="" required
                                class="w-full placeholder:font-medium text-black placeholder:capitalize pl-12 pr-3 placeholder:text-stone-400  rounded-4xl md:h-11 h-11.5 max-md:border  max-md:focus:ring-2 ring-fuchsia-300 border-black focus:outline-none focus:border-fuchsia-500  focus:border-2 bg-white  border "
                                id="email" placeholder="enter your email">
                            <svg id="loginEmailSvg" class="size-6 left-[3%] top-[25%] text-black  absolute"
                                xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48">
                                <path d="M0 0h48v48H0z" fill="none" />
                                <path fill="currentColor"
                                    d="M10.25 8A6.25 6.25 0 0 0 4 14.25v19.5A6.25 6.25 0 0 0 10.25 40h27.5A6.25 6.25 0 0 0 44 33.75v-19.5A6.25 6.25 0 0 0 37.75 8zM6.5 14.25a3.75 3.75 0 0 1 3.75-3.75h27.5a3.75 3.75 0 0 1 3.75 3.75v.89l-17.498 9.21L6.5 15.063zm0 3.644l16.914 8.974a1.25 1.25 0 0 0 1.168.002L41.5 17.965V33.75a3.75 3.75 0 0 1-3.75 3.75h-27.5a3.75 3.75 0 0 1-3.75-3.75z" />
                            </svg>

                        </div>
                        <span id="emailError"
                            class="error-text max-md:px-[2%] text-red-500 text-[15px] text-nowrap hidden">
                        </span>
                    </div>
                    <div class="md:w-full w-[90%] h-fit">
                        <label for="password"
                            class="capitalize text-black md:translate-y-[60%] text-lg w-full md:px-[2%] max-md:px-[5%]">password</label>
                        <div class="w-full relative  h-fit">
                            <input type="password" id="password" required
                                class="w-full placeholder:font-medium text-black  placeholder:capitalize pl-12 pr-3 placeholder:text-stone-400 rounded-4xl md:h-11 h-11.5 max-md:border border max-md:focus:ring-2 ring-fuchsia-300  border-black focus:outline-none focus:border-fuchsia-500  focus:border-2 bg-white "
                                placeholder="password">
                            <svg id="loginPassSvg" class="size-5 left-[3%] top-[25%] text-black  absolute"
                                xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                                <path d="M0 0h16v16H0z" fill="none" />
                                <path fill="currentColor" fill-rule="evenodd"
                                    d="M8 0a4 4 0 0 1 4 4v2.05a2.5 2.5 0 0 1 2 2.45v5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 13.5v-5a2.5 2.5 0 0 1 2-2.45V4a4 4 0 0 1 4-4M4.5 7A1.5 1.5 0 0 0 3 8.5v5A1.5 1.5 0 0 0 4.5 15h7a1.5 1.5 0 0 0 1.5-1.5v-5A1.5 1.5 0 0 0 11.5 7zM8 1a3 3 0 0 0-3 3v2h6V4a3 3 0 0 0-3-3" />
                            </svg>

                            <div id="passEyeToggleForLogin"
                                class=" absolute z-10 w-fit h-fit text-stone-500 right-[3%] active:scale-80 transition-all duration-200 top-[50%] -translate-y-1/2">


                                <svg id="onHidePassLogin" class="size-6 block" xmlns="http://www.w3.org/2000/svg"
                                    width="24" height="24" viewBox="0 0 24 24">
                                    <path d="M0 0h24v24H0z" fill="none" />
                                    <path fill="none" stroke="currentColor" stroke-linecap="round"
                                        stroke-linejoin="round" stroke-width="2"
                                        d="M2 12C3.0523 7.3229 7.206 4 12 4C16.794 4 20.9477 7.3229 22 12C20.9477 16.6771 16.794 20 12 20C7.206 20 3.0523 16.6771 2 12ZM15 12C15 13.6569 13.6569 15 12 15C10.3431 15 9 13.6569 9 12C9 10.3431 10.3431 9 12 9C13.6569 9 15 10.3431 15 12Z" />
                                </svg>
                                <svg id="onShowPassLogin" class="size-6 hidden" xmlns="http://www.w3.org/2000/svg"
                                    width="24" height="24" viewBox="0 0 24 24">
                                    <path d="M0 0h24v24H0z" fill="none" />
                                    <path fill="none" stroke="currentColor" stroke-linecap="round"
                                        stroke-linejoin="round" stroke-width="2"
                                        d="M18.035 18.035C16.3283 19.2786 14.2337 20 12 20C7.206 20 3.0523 16.6771 2 12C2.562 9.5021 4.0086 7.3904 5.965 5.965M9.8779 4.2211C10.565 4.076 11.2752 4 12 4C16.794 4 20.9477 7.3229 22 12C21.7487 13.1169 21.3206 14.1566 20.7491 15.0922M14.1213 14.1213C13.5785 14.6642 12.8285 15 12 15C10.3431 15 9 13.6569 9 12C9 11.1716 9.3358 10.4216 9.8787 9.8787M2 2L22 22" />
                                </svg>
                            </div>
                        </div>
                        <div id="loginPassCont"
                            class="w-full flex justify-end md:justify-start items-center  h-fit  max-md:px-[5%]">
                            <span id="passwordError"
                                class="error-text max-md:px-[2%] text-red-500 text-[15px] text-nowrap hidden">
                            </span>
                            <p
                                class="text-fuchsia-600 md:hidden text-end text-nowrap   capitalize font-medium">
                                <a href="/forgot-password">forgot
                                    password?</a>
                            </p>
                        </div>
                    </div>
                    <button type="submit" id="loginBtn"
                        class="md:w-full w-[90%] flex-center cursor-pointer gap-4 md:h-11 h-12.5 bg-fuchsia-600 shadow-inner shadow-fuchsia-900 rounded-4xl text-white active:scale-90 transition-all duration-200 font-semibold ">

                        <p>Sign In</p>
                        <svg class="text-white size-6.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                            viewBox="0 0 24 24">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2">
                                <path
                                    d="M9 6c.047-1.093.185-1.79.597-2.326q.242-.313.555-.554c.81-.62 1.985-.62 4.335-.62h.501c2.834 0 4.251 0 5.132.879c.88.878.88 2.293.88 5.121v7c0 2.828 0 4.243-.88 5.121s-2.298.879-5.132.879h-.5c-2.351 0-3.526 0-4.336-.62a3 3 0 0 1-.554-.554C9.185 19.79 9.047 19.093 9 18" />
                                <path d="M15 12H3m9.5 3.5S16 12.922 16 12s-3.5-3.5-3.5-3.5" />
                            </g>
                        </svg>

                    </button>
                </div>
            </form>
            <div id="forLoginFoot" class=" w-full flex flex-col   gap-1.5 justify-center items-center pt-4 ">

                <div class="flex gap-1.5">
                    <p class="capitalize  text-lg md:text-[16px]  text-black font-medium">don't have an account ?
                    </p>
                    <a href="/signup"
                        class="text-fuchsia-600 font-medium md:font-semibold text-lg  md:text-[16px]  capitalize">sign
                        up</a></button>
                </div>
                <p class="text-fuchsia-600 max-md:hidden  capitalize font-semibold"><a href="/forgot-password">forgot
                        password?</a></p>
            </div>
            <div
                class="flex flex-col w-full h-fit justify-center items-center border-t border-stone-500 px-[2%] max-md:hidden mt-4 gap-2">
                <p class="capitalize w-fit px-3 bg-white text-center font-medium text-stone-600 translate-y-[-60%]">or
                </p>
                <button
                    class=" bg-white active:scale-90 transition-all duration-200 ease-in cursor-pointer w-full capitalize  border border-stone-600  rounded-4xl h-11.5 flex justify-center items-center gap-2.5">
                    <svg class="size-6" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48">
                        <path d="M0 0h48v48H0z" fill="none" />
                        <path fill="#FFC107"
                            d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C12.955 4 4 12.955 4 24s8.955 20 20 20s20-8.955 20-20c0-1.341-.138-2.65-.389-3.917" />
                        <path fill="#FF3D00"
                            d="m6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691" />
                        <path fill="#4CAF50"
                            d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.9 11.9 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44" />
                        <path fill="#1976D2"
                            d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917" />
                    </svg>
                    <p class="font-bold text-stone-700">sign in with google</p>
                </button>
            </div>
        </section>
        <section id="signInWith"
            class="md:hidden flex flex-col items-center px-[4%] justify-center bg-white w-full h-[15%]  ">
            <div class="w-full h-full flex border-t border-gray-400  flex-col items-center justify-center">
                <p class="text-black font-medium h-fit px-2 -translate-y-full bg-white">OR</p>
                <div
                    class="border cursor-pointer items-center active:scale-90 transition-all duration-200 gap-5 border-black h-11.5 rounded-4xl w-full flex justify-center ">
                    <svg class="size-7" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48">
                        <path d="M0 0h48v48H0z" fill="none" />
                        <path fill="#FFC107"
                            d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C12.955 4 4 12.955 4 24s8.955 20 20 20s20-8.955 20-20c0-1.341-.138-2.65-.389-3.917" />
                        <path fill="#FF3D00"
                            d="m6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691" />
                        <path fill="#4CAF50"
                            d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.9 11.9 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44" />
                        <path fill="#1976D2"
                            d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917" />
                    </svg>
                    <p class="text-black text-lg  capitalize font-medium">sign in with google</p>
                </div>
            </div>
        </section>
    </main>

    <script>

        const forLoginFoot = document.getElementById('forLoginFoot')
        const onShowPassLogin = document.getElementById('onShowPassLogin')
        const onHidePassLogin = document.getElementById('onHidePassLogin')
        const passEyeToggleForLogin = document.getElementById('passEyeToggleForLogin')
        const email = document.getElementById('email')
        const password = document.getElementById('password')
        const loginForm = document.getElementById('loginForm')
        const emailError = document.getElementById('emailError')
        const loginEmailSvg = document.getElementById('loginEmailSvg')
        const passwordError = document.getElementById('passwordError')
        const loginPassSvg = document.getElementById('loginPassSvg')
        const loginPassCont = document.getElementById('loginPassCont')


        // =========login input regex ============
        email.addEventListener('input', function () {
            if (email.classList.contains('border-red-500')) {
                email.classList.replace('border-red-500', 'border-black')
                email.classList.replace('placeholder:text-red-500', 'placeholder:text-stone-400')
            }
            if (emailError.classList.contains('block')) {
                emailError.classList.replace('block', 'hidden')
            }
            document.getElementById('emailError').style.display = 'none';

            this.value = this.value
                .replace(/\s/g, '')
        })

        password.addEventListener('input', function () {
            if (password.classList.contains('border-red-500')) {
                password.classList.replace('border-red-500', 'border-black')
                password.classList.replace('placeholder:text-red-500', 'placeholder:text-stone-400')

            }
            document.getElementById('passwordError').style.display = 'none';

            if (loginPassSvg.classList.contains('text-red-500')) {
                loginPassSvg.classList.replace('text-red-500', 'text-black')

            }
            loginPassCont.classList.replace('justify-between', 'justify-end')
        })

        // ===== loginbox eye toggle =====
        passEyeToggleForLogin.addEventListener('click', () => {
            if (onHidePassLogin.classList.contains('block')) {
                onHidePassLogin.classList.replace('block', 'hidden')
                onShowPassLogin.classList.replace('hidden', 'block')
                password.type = 'text'
            } else {
                onShowPassLogin.classList.replace('block', 'hidden')
                onHidePassLogin.classList.replace('hidden', 'block')
                password.type = 'password'

            }
        })
        const messageBox = document.getElementById('messageBox')

        const messageText = document.getElementById('messageText')
        const messageTextCont = document.getElementById('messageTextCont')
        const closeToastError = document.getElementById('closeToastError')
        const loginBtn = document.getElementById('loginBtn')
        loginForm.addEventListener('submit', async (event) => {
            event.preventDefault()
            loginBtn.textContent = '....'
            const payLoad = {
                email: email.value,
                password: password.value
            }

            try {
                const response = await fetch('/login-post', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payLoad)
                })
                const errorJson = await response.json()
                console.log(errorJson)

                if (response.status === 400) {

                    document.querySelectorAll('.error-text').forEach(el => {
                        el.innerText = '';
                        el.style.display = 'none';
                    });

                    Object.keys(errorJson.errors).forEach(fieldName => {
                        const rawMessage = errorJson.errors[fieldName];
                        const cleanMessage = rawMessage.replace(/['"]/g, ''); // Removes Joi quotes
                        const errorElement = document.getElementById(`${fieldName}Error`);
                        const errorInputBox = document.getElementById(`${fieldName}`)
                        if (errorElement) {
                            errorElement.innerText = cleanMessage;
                            errorElement.style.display = 'block';

                            if (errorInputBox.classList.contains('border-black')) {
                                errorInputBox.classList.remove('border-black', 'placeholder:text-stone-400')
                                errorInputBox.classList.add('border-red-500', 'placeholder:text-red-500')
                                setTimeout(() => {
                                    errorInputBox.classList.add('shake2')
                                    setTimeout(() => {
                                        errorInputBox.classList.remove('shake2')
                                    }, 600)
                                }, 100)
                            }
                        }

                    });
                }

                if (response.status === 401) {

                    if (errorJson.error === 'Invalid Email') {
                        if (email.classList.contains('border-black')) {
                            email.classList.remove('border-black')
                            email.classList.add('border-red-500')
                        }
                        emailError.style.display = 'block';

                        emailError.textContent = errorJson.error


                        setTimeout(() => {
                            email.classList.add('shake2')
                            setTimeout(() => {
                                email.classList.remove('shake2')
                            }, 600)
                        }, 100)
                    }



                    // ======= for incorrect password =========

                    if (errorJson.error === 'Incorrect Password') {
                        if (password.classList.contains('border-black')) {
                            password.classList.remove('border-black')
                            password.classList.add('border-red-500')
                        }
                        console.log(errorJson.error)
                        passwordError.style.display = 'block';
                        passwordError.textContent = errorJson.error
                        loginPassCont.classList.replace('justify-end', 'justify-between')
                        setTimeout(() => {
                            password.classList.add('shake2')
                            password.value = ''
                            setTimeout(() => {
                                password.classList.remove('shake2')
                            }, 300)
                        }, 400)
                    }
                }
                if (response.status === 403) {
                    window.location = `/verify-email?email=${email.value}`
                }
                if (response.ok) {
                    window.location = '/'
                }
            } catch (error) {
                console.log(error)
            }

            finally {
                loginBtn.innerHTML = ` <p>Sign In</p>
                        <svg class="text-white size-6.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                            viewBox="0 0 24 24">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2">
                                <path
                                    d="M9 6c.047-1.093.185-1.79.597-2.326q.242-.313.555-.554c.81-.62 1.985-.62 4.335-.62h.501c2.834 0 4.251 0 5.132.879c.88.878.88 2.293.88 5.121v7c0 2.828 0 4.243-.88 5.121s-2.298.879-5.132.879h-.5c-2.351 0-3.526 0-4.336-.62a3 3 0 0 1-.554-.554C9.185 19.79 9.047 19.093 9 18" />
                                <path d="M15 12H3m9.5 3.5S16 12.922 16 12s-3.5-3.5-3.5-3.5" />
                            </g>
                        </svg>`
            }

        })

    </script>
</body>

</html>