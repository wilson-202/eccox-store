  <script>
    const searchBar = document.getElementById('searchBar')
    const clearSearchBar = document.getElementById('clearSearchBar')
    searchBar.addEventListener('input', () => {
      if (searchBar.value !== '') {
        clearSearchBar.classList.remove('hidden')
      } else {
        clearSearchBar.classList.add('hidden')
      }
    })

    clearSearchBar.addEventListener('click', () => {
      searchBar.value = ''
    })
    const prev = document.getElementById('prev')
    const next = document.getElementById('next')
    const dotCont = document.getElementById('dots')
    const slides = document.querySelectorAll('.slide')
    let current = 0
    slides.forEach((_, i) => {
      const dot = document.createElement('button')
      dot.className = 'rounded-4xl hover:scale-110 transition-all duration-200 cursor-pointer h-2 w-2 bg-gray-500 '
      dot.addEventListener('click', () => goTo(i))
      dotCont.appendChild(dot)
    })


    const dots = dotCont.querySelectorAll('button')
    function update() {
      slides.forEach((slide, i) => {
        slide.style.opacity = i === current ? '1' : '0'
      })

      dots.forEach((dot, i) => {
        dot.classList.toggle('w-6', i === current)
        dot.classList.toggle('w-2', i !== current)
      })

    }
    function goTo(index) {
      current = (index + slides.length) % slides.length
      update()
    }

    next.addEventListener('click', () => {
      goTo(current + 1)
    })
    prev.addEventListener('click', () => {
      goTo(current - 1)
      console.log('weuafdgwukayjdh')
    })
    update()

    setInterval(() => {
      goTo(current + 1)

    }, 5000)

    const heroSec = document.getElementById('heroSec')
    const category = document.getElementById('category')
    const categoryMenu = document.getElementById('categoryMenu')
    category.addEventListener('mouseenter', () => {
      //  alert('wsyhfwrukjgfvuesghrv')
      categoryMenu.classList.remove('opacity-0', '-z-5')
      heroSec.classList.add('-z-10')
    })
    categoryMenu.addEventListener('mouseleave', function () {
      // alert('liudhgildygrtduityrd')
      categoryMenu.classList.add('opacity-0', '-z-5')

      //  categoryMenu.classList.add('hidden')
      heroSec.classList.remove('-z-10')
    })

  </script>
</body>

</html>