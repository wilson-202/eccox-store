                        </svg>

                        <div id="passEyeToggle"
                            class=" absolute z-10 w-fit h-fit text-stone-500 md:text-stone-500 right-[3%] active:scale-80 transition-all duration-200 top-[26%] md:top-[23%]">


                            <svg id="onHidePass" class="md:size-6 size-6.5 block" xmlns="http://www.w3.org/2000/svg"
