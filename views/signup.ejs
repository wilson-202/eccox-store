                </div>
                <div class="w-full flex flex-col items-start gap-1 h-fit ">
                    <div class="w-full relative h-fit">
                        <input type="email" name="" required
                            class="w-full placeholder:font-medium text-black  placeholder:capitalize pl-12 pr-3 placeholder:text-stone-400 rounded-4xl md:h-11 h-13 focus:outline-none focus:border-fuchsia-500  focus:border-2  border border-black bg-white"
