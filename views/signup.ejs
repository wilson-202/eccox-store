                                    stroke-width="2"
                                    d="M2 12C3.0523 7.3229 7.206 4 12 4C16.794 4 20.9477 7.3229 22 12C20.9477 16.6771 16.794 20 12 20C7.206 20 3.0523 16.6771 2 12ZM15 12C15 13.6569 13.6569 15 12 15C10.3431 15 9 13.6569 9 12C9 10.3431 10.3431 9 12 9C13.6569 9 15 10.3431 15 12Z" />
                            </svg>

                            <svg id="onShowPass" class="md:size-6 size-6.5  hidden" xmlns="http://www.w3.org/2000/svg"
                                width="24" height="24" viewBox="0 0 24 24">
                                <path d="M0 0h24v24H0z" fill="none" />
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M18.035 18.035C16.3283 19.2786 14.2337 20 12 20C7.206 20 3.0523 16.6771 2 12C2.562 9.5021 4.0086 7.3904 5.965 5.965M9.8779 4.2211C10.565 4.076 11.2752 4 12 4C16.794 4 20.9477 7.3229 22 12C21.7487 13.1169 21.3206 14.1566 20.7491 15.0922M14.1213 14.1213C13.5785 14.6642 12.8285 15 12 15C10.3431 15 9 13.6569 9 12C9 11.1716 9.3358 10.4216 9.8787 9.8787M2 2L22 22" />
                            </svg>

                        </div>


                    </div>
                    <span id="passwordError"
                        class="error-text max-md:px-[2%] text-red-500 text-[15px] text-nowrap hidden"></span>
                </div>
                <button type="submit" id="signupBtn"
                    class="w-full mt-2 flex-center gap-5 rounded-4xl cursor-pointer h-13  disabled:bg-fuchsia-400 bg-fuchsia-600 shadow-inner shadow-fuchsia-900  text-white font-semibold md:h-11 active:scale-90 capitalize transition-all duration-200 ">
                    <p>
                        sign up
                    </p>
                    <svg class="size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                            stroke-width="2"
                            d="M14.5 6c-.047-1.093-.185-1.79-.598-2.326a3 3 0 0 0-.554-.554c-.81-.62-1.985-.62-4.335-.62h-.501c-2.834 0-4.251 0-5.132.879c-.88.878-.88 2.293-.88 5.121v7c0 2.828 0 4.243.88 5.121s2.298.879 5.132.879h.5c2.351 0 3.526 0 4.336-.62q.314-.241.554-.554c.413-.536.551-1.233.598-2.326m6-6h-12m9.5 3.5s3.5-2.578 3.5-3.5S18 8.5 18 8.5" />
                    </svg>

                </button>
                <div class="text-[16px]  font-medium text-center text-black ">Already have an
                    account? <a href="/login-user" class="capitalize text-fuchsia-600 font-bold">login</a></div>
            </form>
            <div id="forSignupFoot"
                class="w-full border-t border-stone-500 h-fit flex flex-col gap-3 mt-3 items-center ">
                <p class="translate-y-[-60%] w-fit px-3.5 bg-white  text-black  font-medium capitalize">
                    or</p>
                <section class="flex w-full justify-center px-[3%] items-center gap-7 md:gap-10">
                    <div
                        class=" bg-white active:scale-90 transition-all duration-200 ease-in cursor-pointer w-full capitalize  border border-stone-600  rounded-4xl h-11.5 flex justify-center items-center gap-2.5">
                        <svg class="size-6" xmlns="http://www.w3.org/2000/svg" width="48" height="48"
                            viewBox="0 0 48 48">
                            <path d="M0 0h48v48H0z" fill="none" />
                            <path fill="#FFC107"
                                d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C12.955 4 4 12.955 4 24s8.955 20 20 20s20-8.955 20-20c0-1.341-.138-2.65-.389-3.917" />
                            <path fill="#FF3D00"
                                d="m6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691" />
                            <path fill="#4CAF50"
                                d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.9 11.9 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44" />
                            <path fill="#1976D2"
                                d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917" />
                        </svg>
                        <p class="text-[16px] font-medium  text-black">sign up with google</p>


                    </div>

                </section>
            </div>

        </section>
    </main>


    <script>

        // // ============  = =============
        const signUpForm = document.getElementById('signUpForm')
        const firstName = document.getElementById('firstName')
        const lastName = document.getElementById('lastName')
        const email = document.getElementById('email')
        const password = document.getElementById('password')
        const messageBox = document.getElementById('messageBox')
        const smSignup = document.getElementById('smSignup')
        const signupBtn = document.getElementById('signupBtn')
        const smallScreen = window.matchMedia('(max-width: 640px)').matches

        // ====== input signup regex =======
        firstName.addEventListener('input', function () {
            if (firstName.classList.contains('border-red-500')) {
                firstName.classList.replace('border-red-500', 'border-black')
                firstName.classList.replace('placeholder:text-red-500', 'placeholder:text-stone-400')

            }
            document.getElementById('firstNameError').style.display = 'none';

            this.value = this.value
                .replace(/[^a-zA-Z]/g, '')
        })

        lastName.addEventListener('input', function () {
            if (lastName.classList.contains('border-red-500')) {
                lastName.classList.replace('border-red-500', 'border-black')
                lastName.classList.replace('placeholder:text-red-500', 'placeholder:text-stone-400')

            }
            document.getElementById('lastNameError').style.display = 'none';

            this.value = this.value
                .replace(/[^a-zA-Z]/g, '')
        })
        email.addEventListener('input', function () {
            if (email.classList.contains('border-red-500')) {
                email.classList.replace('border-red-500', 'border-black')
                email.classList.replace('placeholder:text-red-500', 'placeholder:text-stone-400')

            }
            document.getElementById('emailError').style.display = 'none';

            this.value = this.value
                .replace(/\s/g, '')
        })
        password.addEventListener('input', function () {
            if (password.classList.contains('border-red-500')) {
                password.classList.replace('border-red-500', 'border-black')
                password.classList.replace('placeholder:text-red-500', 'placeholder:text-stone-400')

            }
            document.getElementById('passwordError').style.display = 'none';

            // this.value = this.value
            //     .replace(/[^a-zA-Z0-9@#$]/g, '')
        })


        // ======= passwordEye=====
        const passEyeToggle = document.getElementById('passEyeToggle')
        const onHidePass = document.getElementById('onHidePass')
        const onShowPass = document.getElementById('onShowPass')

        const passEyeToggle2 = document.getElementById('passEyeToggle2')
        const onHidePass2 = document.getElementById('onHidePass2')
        const onShowPass2 = document.getElementById('onShowPass2')

        passEyeToggle.addEventListener('click', () => {
            if (onHidePass.classList.contains('block')) {
                onHidePass.classList.replace('block', 'hidden')
                password.type = 'text'
                onShowPass.classList.replace('hidden', 'block')
            } else {
                onShowPass.classList.replace('block', 'hidden')
                password.type = 'password'
                onHidePass.classList.replace('hidden', 'block')
            }
        })



        // ====== form submission =======
        const messageText = document.getElementById('messageText')
        // const firstNameError = document.getElementById('firstNameError')
        const closeToastError = document.getElementById('closeToastError')
        signUpForm.addEventListener('submit', async (event) => {
            event.preventDefault()
            try {


                signupBtn.disabled = true
                signupBtn.textContent = '...'
                const payLoad = {
                    firstName: firstName.value,
                    lastName: lastName.value,
                    email: email.value,
                    password: password.value
                }
                const response = await fetch('/signup-post', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payLoad)
                })
                const errorJson = await response.json()

                if (response.ok) {
                    window.location = `/verify-email?email=${email.value}`
                }
                if (errorJson.code === 'VALIDATION_ERROR' && response.status === 400) {
                    console.log(errorJson)
                    document.querySelectorAll('.error-text').forEach(el => {
                        el.innerText = '';
                        el.style.display = 'none';
                    });
                    Object.keys(errorJson.errors).forEach(fieldName => {
                        const rawMessage = errorJson.errors[fieldName];
                        const cleanMessage = rawMessage.replace(/['"]/g, ''); // Removes Joi quotes
                        const errorElement = document.getElementById(`${fieldName}Error`);
                        const errorInputBox = document.getElementById(`${fieldName}`)
                        if (errorElement) {
                            errorElement.innerText = cleanMessage;
                            errorElement.style.display = 'block';

                            if (errorInputBox.classList.contains('border-black')) {
                                errorInputBox.classList.remove('border-black', 'placeholder:text-stone-400')
                                errorInputBox.classList.add('border-red-500', 'placeholder:text-red-500')
                                setTimeout(() => {
                                    errorInputBox.classList.add('shake2')
                                    setTimeout(() => {
                                        errorInputBox.classList.remove('shake2')
                                    }, 600)
                                }, 100)
                            }
                        }

                    });

                }
                if (response.status === 409) {
                    const emailError = document.getElementById('emailError')
                    emailError.innerText = errorJson.error;
                    emailError.style.display = 'block';
                    if (email.classList.contains('border-black')) {
                        email.classList.remove('border-black', 'placeholder:text-stone-400')
                        email.classList.add('border-red-500', 'placeholder:text-red-500')
                        setTimeout(() => {
                            email.classList.add('shake2')
                            setTimeout(() => {
                                email.classList.remove('shake2')
                            }, 600)
                        }, 100)
                    }
                }
            }

            finally {
                signupBtn.disabled = false
                signupBtn.innerHTML = ` <p>
                        sign up
                    </p>
                    <svg class="size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                            stroke-width="2"
                            d="M14.5 6c-.047-1.093-.185-1.79-.598-2.326a3 3 0 0 0-.554-.554c-.81-.62-1.985-.62-4.335-.62h-.501c-2.834 0-4.251 0-5.132.879c-.88.878-.88 2.293-.88 5.121v7c0 2.828 0 4.243.88 5.121s2.298.879 5.132.879h.5c2.351 0 3.526 0 4.336-.62q.314-.241.554-.554c.413-.536.551-1.233.598-2.326m6-6h-12m9.5 3.5s3.5-2.578 3.5-3.5S18 8.5 18 8.5" />
                    </svg>`
            }
        })

        // function closeToast() {
        //     setTimeout(() => {
        //         messageBox.classList.replace('translate-x-0', 'tran')
        //     }, 5000)
        // }

        // closeToastError.addEventListener('click', () => {
        //     messageBox.classList.replace('translate-x-0', 'tran')

        // })

    </script>
</body>

