    <script>

        // // ============  = =============
        const signUpForm = document.getElementById('signUpForm')
        const firstName = document.getElementById('firstName')
        const lastName = document.getElementById('lastName')
        const email = document.getElementById('email')
        const password = document.getElementById('password')
        const cPassword = document.getElementById('cPassword')
        const messageBox = document.getElementById('messageBox')
        const smSignup = document.getElementById('smSignup')
        const signupBtn = document.getElementById('signupBtn')
        const smallScreen = window.matchMedia('(max-width: 640px)').matches
        if (smallScreen) {
            console.log('qyjghkdvkaufjb ')
        }

        if (smallScreen) {
            window.addEventListener('pageshow', () => {
                setTimeout(() => {

                    smSignup.classList.replace('max-md:translate-y-full', 'max-md:signupAnim')
                }, 1000)
            })
        }
        // ====== input signup regex =======
        firstName.addEventListener('input', function () {
            this.value = this.value
                .replace(/[^a-zA-Z]/g, '')
        })

        lastName.addEventListener('input', function () {
            this.value = this.value
                .replace(/[^a-zA-Z]/g, '')
        })
        email.addEventListener('input', function () {
            this.value = this.value
                .replace(/[^a-zA-Z0-9@.]/g, '')
        })
        password.addEventListener('input', function () {
            this.value = this.value
                .replace(/[^a-zA-Z0-9@#$]/g, '')
        })
        cPassword.addEventListener('input', function () {
            this.value = this.value
                .replace(/[^a-zA-Z0-9@#$]/g, '')
        })

        // ======= passwordEye=====
        const passEyeToggle = document.getElementById('passEyeToggle')
        const onHidePass = document.getElementById('onHidePass')
        const onShowPass = document.getElementById('onShowPass')

        const passEyeToggle2 = document.getElementById('passEyeToggle2')
        const onHidePass2 = document.getElementById('onHidePass2')
        const onShowPass2 = document.getElementById('onShowPass2')

        passEyeToggle.addEventListener('click', () => {
            if (onHidePass.classList.contains('block')) {
                onHidePass.classList.replace('block', 'hidden')
                password.type = 'text'
                onShowPass.classList.replace('hidden', 'block')
            } else {
                onShowPass.classList.replace('block', 'hidden')
                password.type = 'password'
                onHidePass.classList.replace('hidden', 'block')
            }
        })
        passEyeToggle2.addEventListener('click', () => {
            if (onHidePass2.classList.contains('block')) {
                onHidePass2.classList.replace('block', 'hidden')
                cPassword.type = 'text'
                onShowPass2.classList.replace('hidden', 'block')
            } else {
                onShowPass2.classList.replace('block', 'hidden')
                cPassword.type = 'password'
                onHidePass2.classList.replace('hidden', 'block')
            }
        })


        // ====== form submission =======
        const messageText = document.getElementById('messageText')
        const closeToastError = document.getElementById('closeToastError')
        signUpForm.addEventListener('submit', async (event) => {
            event.preventDefault()
            try {


                signupBtn.disabled = true
                signupBtn.textContent = '...'
                if ((firstName.value !== '' && lastName.value !== '', email.value !== '' && password.value !== '') && cPassword.value === '') {
                    messageBox.classList.replace('tran', 'translate-x-0')
                    closeToast()
                    return messageText.innerText = 'Confirm your password'
                }

                if (password.value !== cPassword.value) {
                    messageBox.classList.replace('tran', 'translate-x-0')
                    closeToast()
                    return messageText.innerText = 'Passwords does not match'
                }

                const payLoad = {
                    firstName: firstName.value,
                    lastName: lastName.value,
                    email: email.value,
                    password: password.value
                }




                const response = await fetch('/signup-post', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payLoad)
                })

                if (response.ok) {
                    window.location = '/verify-email'
                } else {
                    const errorCode = response.status;
                    const errorJson = await response.json()
                    messageBox.classList.replace('tran', 'translate-x-0')
                    closeToast()
                    const clearmessage = errorJson.error || errorJson.errors[0].replace(/['"]/g, '')
                    messageText.innerText = clearmessage
                    console.log(errorJson)
                    console.log(errorCode)
                }
            }

            finally {
                signupBtn.disabled = false
                signupBtn.textContent = 'Create an Account'
            }
        })

        function closeToast() {
            setTimeout(() => {
                messageBox.classList.replace('translate-x-0', 'tran')
