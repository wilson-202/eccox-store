<!doctype html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="output.css" rel="stylesheet">
    <title>reset password</title>
</head>

<body
    style="font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;">
    <main class="h-screen overflow-hidden w-full ">
        <form action="" id="resetForm" class="flex justify-start relative gap-3.5 w-full flex-col h-full">
            <div id="messageBox"
                class="rounded-[21px] flex  customCubic border-2 border-red-800 p-0.5 right-[2%] top-[7%]  text-stone-100 font-semibold  tran content-center text-left duration-150 transition-all   absolute z-16   h-19 w-[90%] md:w-[26%]">
                <div id="messageTextCont"
                    class="w-full flex justify-between gap-2 px-2.5 items-center bg-red-500 shadow-red-600 h-full rounded-2xl ">
                    <div class="bg-stone-200 p-2 rounded-4xl flex justify-center items-center">

                        <svg class="size-7  -translate-y-0.5 text-red-800" xmlns="http://www.w3.org/2000/svg" width="24"
                            height="24" viewBox="0 0 24 24">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <path fill="currentColor"
                                d="M4.47 21h15.06c1.54 0 2.5-1.67 1.73-3L13.73 4.99c-.77-1.33-2.69-1.33-3.46 0L2.74 18c-.77 1.33.19 3 1.73 3M12 14c-.55 0-1-.45-1-1v-2c0-.55.45-1 1-1s1 .45 1 1v2c0 .55-.45 1-1 1m1 4h-2v-2h2z" />
                        </svg>
                    </div>
                    <p id="messageText" class="text-sm font-medium font-mono"></p>
                    <svg id="closeToastError"
                        class="size-6.5  active:scale-90 transition-all duration-200 -translate-y-2 hover:bg-red-400 rounded-4xl p-0.5"
                        xmlns="http://www.w3.org/2000/svg" width="2048" height="2048" viewBox="0 0 2048 2048">
                        <path d="M0 0h2048v2048H0z" fill="none" />
                        <path fill="currentColor"
                            d="m1115 1024l690 691l-90 90l-691-690l-691 690l-90-90l690-691l-690-691l90-90l691 690l691-690l90 90z" />
                    </svg>


                </div>
            </div>


            <div class="absolute md:top-2.5 max-md:bottom-[9%] max-md:right-[19%] md:right-4">
                <p class="text-sm font-medium">Dont have an account?<a
                        class="capitalize text-fuchsia-600 font-semibold ml-2" href="/signup">register now</a></p>
            </div>
            <div class="absolute bottom-3 text-sm md:left-3 max-md:left-[30%] text-stone-700">
                Copyright © 2026
            </div>
            <!-- <div class="absolute top-3 left-3 font-bold text-2xl text-black">
                <p>Eccox store</p>
            </div> -->
            <div class="flex justify-center items-center ">
                <img class="size-80"
                    src="hand-drawn-illustration-of-doodle-wood-road-signs-and-arrows-free-vector (1).jpg" alt="">

            </div>
            <div class="flex justify-center flex-col gap-1 items-center ">
                <h1 class="text-3xl  text-black font-bold">Forgot your password?</h1>
                <p class="text-sm">Enter your email so you can reset your password</p>
            </div>
            <div class="flex justify-center gap-3.5 items-center w-full flex-col">
                <div class="flex flex-col w-[90%] md:w-[40%]">

                    <label for="forEmail" class="capitalize mx-5 font-semibold">email</label>
                    <input
                        class="h-11 rounded-4xl px-4 border-2 border-stone-300 w-full focus:outline-none focus:border-2 focus:border-fuchsia-600"
                        type="text" name="" placeholder="e.g username@eccox.com" id="forEmail">
                </div>

                <button id="submitBtn"
                    class="font-medium capitalize w-[90%] my-2 md:my-0 md:w-[40%] h-11 active:scale-90 transition-all duration-200 rounded-4xl bg-fuchsia-600 text-white">send
                    code</button>
            </div>
            <div class="flex justify-center items-center gap-2.5">
                <svg class="size-5 md:size-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                    viewBox="0 0 24 24">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                        stroke-width="2" d="m15 19l-7-7l7-7" />
                </svg>

                <p class="font-medium">
                    <a href="/login-user"> Back to Login</a>
                </p>
            </div>
        </form>
    </main>


    <script>
        const resetForm = document.getElementById('resetForm')
        const forEmail = document.getElementById('forEmail')
        const messageText = document.getElementById('messageText')
        const messageTextCont = document.getElementById('messageTextCont')
        const closeToastError = document.getElementById('closeToastError')
        const submitBtn = document.getElementById('submitBtn')

        forEmail.addEventListener('input', function () {
            this.value = this.value
                .replace(/[^a-zA-Z@_.0-9\-]/g, '')
        })
        const messageBox = document.getElementById('messageBox')

        resetForm.addEventListener('submit', async (event) => {
            event.preventDefault()
            if (!navigator.onLine) {
                messageBox.classList.replace('tran', 'translate-x-0')
                closeToast()
                forEmail.classList.add('shake')
                setTimeout(() => {
                    forEmail.classList.remove('shake')
                }, 200)
                return messageText.innerText = 'Network error. Check your connection and try again.'
            }


            submitBtn.disabled = true
            submitBtn.textContent = 'Submitting...'
            const payLoad = {
                email: forEmail.value
            }
            try {


                const response = await fetch('/reset-email-submit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payLoad)
                })

                const errorJson = await response.json()
                if (!response.ok) {
                    messageBox.classList.replace('tran', 'translate-x-0')
                    messageTextCont.classList.remove('bg-green-600', 'shadow-green-600')
                    closeToast()
                    const clearmessage = errorJson.error || errorJson.errors[0].replace(/['"]/g, '')
                    messageText.innerText = clearmessage
                } else {
                    window.location = `/verify-otp?email=${forEmail.value}`
                }

            } catch (error) {
                console.log(error)
                messageBox.classList.replace('tran', 'translate-x-0')
                closeToast()
                messageText.innerText = 'Network error. Please check your connection and try again.'
            }

            finally {
                submitBtn.disabled = false
                submitBtn.textContent = 'Send Code'
            }
        })


        closeToastError.addEventListener('click', () => {
            messageBox.classList.replace('translate-x-0', 'tran')

        })
        function closeToast() {
            setTimeout(() => {
                messageBox.classList.replace('translate-x-0', 'tran')
            }, 4000)
        }


    </script>

</body>

</html>