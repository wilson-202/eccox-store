<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="output.css" rel="stylesheet">
    <title> </title>
</head>

<body>
    <main
        class="overflow-hidden flex flex-col md:flex-row justify-center items-center bg-fuchsia-200 w-full h-screen relative">
        <div id="messageBox"
            class="rounded-[21px] flex  customCubic border-2 border-red-800 p-0.5 right-[2%] top-[7%]  text-stone-100 font-semibold  tran content-center text-left duration-150 transition-all   absolute z-16   h-19 w-[26%]">
            <div id="messageTextCont"
                class="w-full flex justify-between gap-2 px-2.5 items-center bg-red-500 shadow-red-600 h-full rounded-2xl ">
                <div class="bg-stone-200 p-2 rounded-4xl flex justify-center items-center">

                    <svg class="size-7  -translate-y-0.5 text-red-800" xmlns="http://www.w3.org/2000/svg" width="24"
                        height="24" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <path fill="currentColor"
                            d="M4.47 21h15.06c1.54 0 2.5-1.67 1.73-3L13.73 4.99c-.77-1.33-2.69-1.33-3.46 0L2.74 18c-.77 1.33.19 3 1.73 3M12 14c-.55 0-1-.45-1-1v-2c0-.55.45-1 1-1s1 .45 1 1v2c0 .55-.45 1-1 1m1 4h-2v-2h2z" />
                    </svg>
                </div>
                <p id="messageText" class="text-sm font-medium font-mono"></p>
                <svg id="closeToastError"
                    class="size-5 active:scale-90 transition-all duration-200 -translate-y-2 hover:bg-red-400 rounded-4xl p-0.5"
                    xmlns="http://www.w3.org/2000/svg" width="2048" height="2048" viewBox="0 0 2048 2048">
                    <path d="M0 0h2048v2048H0z" fill="none" />
                    <path fill="currentColor"
                        d="m1115 1024l690 691l-90 90l-691-690l-691 690l-90-90l690-691l-690-691l90-90l691 690l691-690l90 90z" />
                </svg>


            </div>
        </div>
        <section class="md:w-[55%] w-full md:h-full h-[45%]  flex justify-center items-center relative  ">
            <div class="absolute bottom-3 left-3.5 text-stone-800 hidden md:block text-sm">Copyright © 2026</div>
            <img class="w-full max-md:w-auto h-[80%]" src="otp-security-illustration-svg-download-png-3240399.png"
                alt="">
        </section>
        <section class="md:w-[45%] w-full  md:h-full h-[55%]  flex justify-center items-center">

            <form id="formNewPass"
                class="md:border-2  border-fuchsia-400 md:gap-1.5 gap-8 px-3 md:px-0 bg-white flex justify-center items-center flex-col md:h-[60%] h-full w-full md:w-[77%] md:rounded-2xl"
                action="">
                <!-- <div class="h-11 w-[75%]">

                    <input class="w-full h-full border-2 rounded-2xl" id="passwordNew" type="password">
                </div>
                <div class="h-11 w-[75%]">

                    <input class="w-full h-full border-2 rounded-2xl" id="cPasswordNew" type="password">
                </div> -->



                <div class="my-2">
                    <h1 class="text-3xl font-bold capitalize">create new password</h1>
                    <p class="text-sm font-medium text-stone-800">Please kindly set up a new password you can remember
                    </p>
                </div>


                <div class="md:flex w-full hidden  pl-[15%] items-center">
                    <label class="text-sm font-medium capitalize" for="passwordNew">new password</label>

                </div>
                <div class="md:w-[75%] w-full relative h-fit">

                    <input type="password" id="passwordNew"
                        class="w-full placeholder:font-medium text-black placeholder:capitalize pl-12 pr-3 placeholder:text-stone-400 rounded-4xl md:rounded-2xl h-13 md:h-11 focus:outline-none focus:border-fuchsia-500  focus:border-2  bg-fuchsia-200 focus:bg-white"
                        placeholder="Create Password">
                    <svg class="size-5 left-[3%] top-[32%] md:top-[25%] text-stone-700 absolute"
                        xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                        <path d="M0 0h16v16H0z" fill="none" />
                        <path fill="currentColor" fill-rule="evenodd"
                            d="M8 0a4 4 0 0 1 4 4v2.05a2.5 2.5 0 0 1 2 2.45v5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 13.5v-5a2.5 2.5 0 0 1 2-2.45V4a4 4 0 0 1 4-4M4.5 7A1.5 1.5 0 0 0 3 8.5v5A1.5 1.5 0 0 0 4.5 15h7a1.5 1.5 0 0 0 1.5-1.5v-5A1.5 1.5 0 0 0 11.5 7zM8 1a3 3 0 0 0-3 3v2h6V4a3 3 0 0 0-3-3" />
                    </svg>

                    <div id="passEyeToggle"
                        class=" absolute z-10 w-fit h-fit text-stone-500 right-[4%] md:right-[3%] active:scale-80 transition-all duration-200 top-[32%] md:top-[23%]">


                        <svg id="onHidePass" class="size-6 block" xmlns="http://www.w3.org/2000/svg" width="24"
                            height="24" viewBox="0 0 24 24">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2"
                                d="M2 12C3.0523 7.3229 7.206 4 12 4C16.794 4 20.9477 7.3229 22 12C20.9477 16.6771 16.794 20 12 20C7.206 20 3.0523 16.6771 2 12ZM15 12C15 13.6569 13.6569 15 12 15C10.3431 15 9 13.6569 9 12C9 10.3431 10.3431 9 12 9C13.6569 9 15 10.3431 15 12Z" />
                        </svg>

                        <svg id="onShowPass" class="size-6 hidden" xmlns="http://www.w3.org/2000/svg" width="24"
                            height="24" viewBox="0 0 24 24">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2"
                                d="M18.035 18.035C16.3283 19.2786 14.2337 20 12 20C7.206 20 3.0523 16.6771 2 12C2.562 9.5021 4.0086 7.3904 5.965 5.965M9.8779 4.2211C10.565 4.076 11.2752 4 12 4C16.794 4 20.9477 7.3229 22 12C21.7487 13.1169 21.3206 14.1566 20.7491 15.0922M14.1213 14.1213C13.5785 14.6642 12.8285 15 12 15C10.3431 15 9 13.6569 9 12C9 11.1716 9.3358 10.4216 9.8787 9.8787M2 2L22 22" />
                        </svg>

                    </div>


                </div>


                <div class="md:flex hidden w-full pl-[15%] items-center">
                    <label class="text-sm font-medium capitalize" for="cPasswordNew">re-enter password</label>

                </div>

                <div class="md:w-[75%] w-full relative h-fit">
                    <input type="password" id="cPasswordNew"
                        class="w-full placeholder:font-medium text-black placeholder:capitalize pl-12 pr-3 placeholder:text-stone-400 rounded-4xl md:rounded-2xl h-13 md:h-11 focus:outline-none focus:border-fuchsia-500  focus:border-2  bg-fuchsia-200 focus:bg-white"
                        placeholder="confirm password">
                    <svg class="size-5 left-[3%] top-[32%] md:top-[25%] text-stone-700 absolute"
                        xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                        <path d="M0 0h16v16H0z" fill="none" />
                        <g fill="currentColor">
                            <path
                                d="M5.338 1.59a61 61 0 0 0-2.837.856a.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.118a1 1 0 0 0 .101.025a1 1 0 0 0 .1-.025q.114-.034.294-.118c.24-.113.547-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453a7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625a11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43A63 63 0 0 1 5.072.56" />
                            <path
                                d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99a1.5 1.5 0 1 1 2-1.415" />
                        </g>
                    </svg>

                    <div id="passEyeToggle2"
                        class=" absolute z-10 w-fit h-fit text-stone-500 right-[4%] md:right-[3%] active:scale-80 transition-all duration-200 top-[32%] md:top-[23%]">


                        <svg id="onHidePass2" class="size-6 block" xmlns="http://www.w3.org/2000/svg" width="24"
                            height="24" viewBox="0 0 24 24">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2"
                                d="M2 12C3.0523 7.3229 7.206 4 12 4C16.794 4 20.9477 7.3229 22 12C20.9477 16.6771 16.794 20 12 20C7.206 20 3.0523 16.6771 2 12ZM15 12C15 13.6569 13.6569 15 12 15C10.3431 15 9 13.6569 9 12C9 10.3431 10.3431 9 12 9C13.6569 9 15 10.3431 15 12Z" />
                        </svg>

                        <svg id="onShowPass2" class="size-6 hidden" xmlns="http://www.w3.org/2000/svg" width="24"
                            height="24" viewBox="0 0 24 24">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                stroke-width="2"
                                d="M18.035 18.035C16.3283 19.2786 14.2337 20 12 20C7.206 20 3.0523 16.6771 2 12C2.562 9.5021 4.0086 7.3904 5.965 5.965M9.8779 4.2211C10.565 4.076 11.2752 4 12 4C16.794 4 20.9477 7.3229 22 12C21.7487 13.1169 21.3206 14.1566 20.7491 15.0922M14.1213 14.1213C13.5785 14.6642 12.8285 15 12 15C10.3431 15 9 13.6569 9 12C9 11.1716 9.3358 10.4216 9.8787 9.8787M2 2L22 22" />
                        </svg>

                    </div>

                </div>


                <button
                    class="md:w-[75%] w-full md:my-6 h-13 md:h-12 active:scale-90 bg-fuchsia-500 shadow-inner shadow-fuchsia-800 md:rounded-2xl rounded-4xl  font-semibold transition-all duration-200 capitalize text-white">Change
                    password</button>
            </form>
        </section>
    </main>


    <script>
        const formNewPass = document.getElementById('formNewPass')
        const passwordNew = document.getElementById('passwordNew')
        const cPasswordNew = document.getElementById('cPasswordNew')
        const messageBox = document.getElementById('messageBox')
        const messageText = document.getElementById('messageText')
        const messageTextCont = document.getElementById('messageTextCont')
        const closeToastError = document.getElementById('closeToastError')




        const passEyeToggle = document.getElementById('passEyeToggle')
        const onHidePass = document.getElementById('onHidePass')
        const onShowPass = document.getElementById('onShowPass')

        const passEyeToggle2 = document.getElementById('passEyeToggle2')
        const onHidePass2 = document.getElementById('onHidePass2')
        const onShowPass2 = document.getElementById('onShowPass2')

        passEyeToggle.addEventListener('click', () => {
            if (onHidePass.classList.contains('block')) {
                onHidePass.classList.replace('block', 'hidden')
                passwordNew.type = 'text'
                onShowPass.classList.replace('hidden', 'block')
            } else {
                onShowPass.classList.replace('block', 'hidden')
                passwordNew.type = 'password'
                onHidePass.classList.replace('hidden', 'block')
            }
        })
        passEyeToggle2.addEventListener('click', () => {
            if (onHidePass2.classList.contains('block')) {
                onHidePass2.classList.replace('block', 'hidden')
                cPasswordNew.type = 'text'
                onShowPass2.classList.replace('hidden', 'block')
            } else {
                onShowPass2.classList.replace('block', 'hidden')
                cPasswordNew.type = 'password'
                onHidePass2.classList.replace('hidden', 'block')
            }
        })







        formNewPass.addEventListener('submit', async (event) => {
            event.preventDefault()
            const email = new URLSearchParams(window.location.search).get('email')
            const code = new URLSearchParams(window.location.search).get('code')

            const payLoad = {
                password: passwordNew.value,
                email: email,
                code: code
            }


            if (cPasswordNew.value.length === '') {
                messageBox.classList.replace('tran', 'translate-x-0')
                closeToast()
                return messageText.innerText = 'confirm password please'
            }
            if (cPasswordNew.value !== passwordNew.value) {
                messageBox.classList.replace('tran', 'translate-x-0')
                closeToast()
                return messageText.innerText = 'Passwords does not match'
            }

            const response = await fetch('/create-new-password-post', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'

                },
                body: JSON.stringify(payLoad)

            })




            const errorJson = await response.json()
            if (!response.ok) {
                messageBox.classList.replace('tran', 'translate-x-0')
                messageTextCont.classList.remove('bg-green-600', 'shadow-green-600')
                closeToast()
                const clearmessage = errorJson.error || errorJson.errors[0].replace(/['"]/g, '')
                messageText.innerText = clearmessage
            } else {
                window.location = `/login-user`
            }
        })

        closeToastError.addEventListener('click', () => {
            messageBox.classList.replace('translate-x-0', 'tran')

        })
        function closeToast() {
            setTimeout(() => {
                messageBox.classList.replace('translate-x-0', 'tran')
            }, 4000)
        }




    </script>
</body>

</html>