            <div
                class="h-[70%] px-10 w-[50%] flex flex-col items-center border-dashed border-2 rounded-2xl  justify-center gap-2.5">
                <div class="flex  items-center  gap-7 w-full">
                    <label for="discountRadio" class="capitalize">discount:</label>
                    <div class="flex items-center gap-5">
