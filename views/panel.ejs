                    </div>
                </div>
                <div class="w-full justify-start items-center hidden gap-8" id="discountBox">
                    <p class="text-nowrap">discount (%)</p>
                    <input type="text" name="discountPercent" maxlength="3" class=" placeholder:capitalize px-3 border-2 rounded-xl h-11 w-25"
                        placeholder="" name="" id="discountBoxInput">
                    <div class="flex items-center gap-5">
