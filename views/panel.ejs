    <script>
        // const aTag =  document.getElementById('aTag')
        // const token = '287yrh232897y397ruhfw3ifh3oi4'
        // aTag.href = `http://localhost:3200/verify-acc/${token}`
        let fileInput = document.getElementById('fileInput');
        let filePlusBtn = document.getElementById('filePlusBtn');
        const previewBox = document.getElementById('previewBox');
        const menuExtra = document.getElementById('menuExtra');
        const menuExtraFile = document.getElementById('menuExtraFile');
        const menuExtraRemove = document.getElementById('menuExtraRemove');
        const img = document.createElement('img');

        function handleFileChange(event) {
            const file = event.target.files[0];
            if (!file) return;

            previewBox.innerHTML = '';
            menuExtra.classList.replace('hidden', 'flex');
            previewBox.classList.replace('outline-cyan-500/80', 'outline-black')
            previewBox.classList.remove('outline-dashed')

            const fileURL = URL.createObjectURL(file);

            if (file.type.startsWith('image/')) {
                // const img = document.createElement('img');
                img.src = fileURL;
                img.style.width = '100%';
                img.style.borderRadius = '16px';
                img.style.height = '100%';
                previewBox.appendChild(img);
            } else if (file.type.startsWith('video/')) {
                const video = document.createElement('video');
                video.src = fileURL;
                video.controls = false;
                video.autoplay = true;
                video.style.width = '100%';
                video.style.height = '100%';
                video.style.borderRadius = '16px';
                video.style.objectFit = 'cover';
                video.loop = true;
                previewBox.appendChild(video);
            }
        }
        filePlusBtn.addEventListener('click', () => {
            fileInput.click();
        });
        fileInput.addEventListener('change', handleFileChange);
        menuExtraFile.addEventListener('click', () => {
            fileInput.click();
        });
        menuExtraRemove.addEventListener('click', () => {
            let reverse = ` <button id="filePlusBtn"
        class="outline-2 outline-cyan-800  text-white p-4 active:scale-90 transition-all duration-200 rounded-4xl">
        <svg class="text-cyan-800 size-7" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
            viewBox="0 0 24 24">
            <path d="M0 0h24v24H0z" fill="none" />
            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="3"
                d="M12 20v-8m0 0V4m0 8h8m-8 0H4" />
        </svg>
    </button>
    <input id="fileInput" type="file" accept="image/*,video/*" class="hidden">
    <p class="font-sans text-cyan-900 capitalize font-medium">add a photo or video</p>`;
            previewBox.innerHTML = '';
            previewBox.innerHTML = reverse;
            menuExtra.classList.replace('flex', 'hidden');
            previewBox.classList.replace('outline-black', 'outline-cyan-500/80')
            previewBox.classList.add('outline-dashed')
            filePlusBtn = document.getElementById('filePlusBtn');
            fileInput = document.getElementById('fileInput');
            filePlusBtn.addEventListener('click', () => {
                fileInput.click();
            });
            fileInput.addEventListener('change', handleFileChange);
        });
        const firstSectBtn = document.getElementById('firstSectBtn')
        const secondSection = document.getElementById('secondSection')
        const discountDisplay = document.getElementById('discountDisplay')
        const firstSection = document.getElementById('firstSection')
        const inputPName = document.getElementById('inputPName')
        const inputPDescription = document.getElementById('inputPDescription')
        const inputPrice = document.getElementById('inputPrice')
        const inputContact = document.getElementById('inputContact')
        const discountBox = document.getElementById('discountBox')
        const discountYes = document.getElementById('discountYes')
        const discountNo = document.getElementById('discountNo')
        discountYes.addEventListener('click', () => {
            if (discountBox.classList.contains('hidden')) {
                discountBox.classList.replace('hidden', 'flex')
            }
        })
        discountNo.addEventListener('click', () => {
            if (discountBox.classList.contains('flex')) {
                discountBox.classList.replace('flex', 'hidden')
            }
        })
        inputPrice.addEventListener('input', function () {
            this.value = this.value
                .replace(/[^0-9]/g, '')
                .replace(/(\..*)\./g, '$1')
        })
        // let test = inputPName.value.trim()
        firstSectBtn.addEventListener('click', () => {
            // console.log(inputPName.value.trim())
            if(menuExtra.classList.contains('flex')){
                menuExtra.classList.replace('flex', 'hidden')
            }
            if (inputPName.value.trim().length > 0 && inputPDescription.value.trim().length > 0 && inputPrice.value.trim().length > 0 && inputContact.value.trim().length > 0 && (previewBox.querySelector('img') || previewBox.querySelector('video'))) {
                firstSection.classList.replace('flex', 'hidden')
                secondSection.classList.replace('hidden', 'flex')
            }

        })
        const discountBoxInput = document.getElementById('discountBoxInput')
        let sellingPrice = 0
        discountBoxInput.addEventListener('input', () => {
            let percent = 100
            let percentRemain = percent - discountBoxInput.value
            const finalDiscountedAmount = (percentRemain / 100) * inputPrice.value
            sellingPrice = finalDiscountedAmount
            discountDisplay.innerText = finalDiscountedAmount

            document.getElementById('originalPrice').innerText = inputPrice.value
        })
        const section3 = document.getElementById('section3')
        const section3Img = document.getElementById('section3Img')
        const discountPercentDIs = document.getElementById('discountPercentDIs')
        const productNameDisplay = document.getElementById('productNameDisplay')
        const descriptionDisplay = document.getElementById('descriptionDisplay')
        const priceDisplay = document.getElementById('priceDisplay')
        const disSellingPrice = document.getElementById('disSellingPrice')
        document.getElementById('secondSectBtn').addEventListener('click', () => {
            if (section3.classList.contains('hidden')) {
                section3.classList.replace('hidden', 'flex')
                secondSection.classList.replace('flex', 'hidden')
                img.style.height = '100%'
                img.style.width = '100%'
                section3Img.appendChild(img)
                if (discountBoxInput.value !== '') {
                    discountPercentDIs.classList.remove('hidden')

                    priceDisplay.classList.add('line-through', 'font-light', 'text-gray-700')
                    discountPercentDIs.innerText = ` - ${discountBoxInput.value}%`
                    disSellingPrice.classList.remove('hidden')
                    disSellingPrice.classList.add('block')
                    disSellingPrice.innerText = sellingPrice
                } else {
                    discountPercentDIs.classList.add('hidden')
                    disSellingPrice.classList.add('hidden')
                    disSellingPrice.classList.remove('block')
                    priceDisplay.classList.remove('line-through')


                }
                productNameDisplay.innerText = inputPName.value
                descriptionDisplay.innerText = inputPDescription.value
                priceDisplay.innerText = inputPrice.value
            }
        })

    </script>
