            <button id="secondSectBtn" type="button"
                class="active:scale-90 transition-all flex items-center  px-8 gap-2.5 duration-200 w-40 capitalize max-md:py-3 py-2 bg-black text-white rounded-2xl ">
                <svg class="size-5.5 rotate-90" xmlns="http://www.w3.org/2000/svg" width="512" height="512"
                    viewBox="0 0 512 512">
                    <path d="M0 0h512v512H0z" fill="none" />
                    <path fill="currentColor" fill-rule="evenodd"
                        d="M277.333 45.554L441.183 197.7l-29.033 31.266l-113.484-105.39v175.09c0 80.757-64.102 146.541-144.2 149.247l-5.133.087h-64v-42.667h64c57.36 0 104.145-45.276 106.568-102.04l.099-4.627l-.001-175.089l-113.483 105.389l-29.033-31.266z" />
