<!doctype html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="output.css" rel="stylesheet">
    <title> </title>
</head>

<body>
    <main class="overflow-hidden h-screen relative font-sans bg-fuchsia-200 flex-col md:flex-row flex w-full">
        <div id="messageBox"
            class="rounded-[21px] flex customCubic border-2 border-red-800 p-0.5 right-[2%] top-[7%]  text-stone-100 font-semibold  tran content-center text-left duration-150 transition-all   absolute z-16   h-19 w-[70%] md:w-[26%]">
            <div id="messageTextCont"
                class="w-full flex justify-between gap-2 px-2.5 items-center bg-red-500 shadow-red-600 h-full rounded-2xl ">
                <div class="bg-stone-200 p-2 rounded-4xl flex justify-center items-center">

                    <svg id="svgToast" class="size-7 block -translate-y-0.5 text-red-800"
                        xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <path fill="currentColor"
                            d="M4.47 21h15.06c1.54 0 2.5-1.67 1.73-3L13.73 4.99c-.77-1.33-2.69-1.33-3.46 0L2.74 18c-.77 1.33.19 3 1.73 3M12 14c-.55 0-1-.45-1-1v-2c0-.55.45-1 1-1s1 .45 1 1v2c0 .55-.45 1-1 1m1 4h-2v-2h2z" />
                    </svg>

                    <svg id="svgToastGreen" class="size-7 hidden  text-green-600" xmlns="http://www.w3.org/2000/svg"
                        width="36" height="36" viewBox="0 0 36 36">
                        <path d="M0 0h36v36H0z" fill="none" />
                        <path fill="currentColor"
                            d="M13.72 27.69L3.29 17.27a1 1 0 0 1 1.41-1.41l9 9L31.29 7.29A1 1 0 0 1 32.7 8.7Z"
                            class="clr-i-outline clr-i-outline-path-1" />
                        <path fill="none" d="M0 0h36v36H0z" />
                    </svg>


                </div>
                <p id="messageText" class="text-sm font-medium font-mono"></p>
                <svg id="closeToastError"
                    class="size-5 active:scale-90 transition-all duration-200 -translate-y-2 hover:bg-red-400 rounded-4xl p-0.5"
                    xmlns="http://www.w3.org/2000/svg" width="2048" height="2048" viewBox="0 0 2048 2048">
                    <path d="M0 0h2048v2048H0z" fill="none" />
                    <path fill="currentColor"
                        d="m1115 1024l690 691l-90 90l-691-690l-691 690l-90-90l690-691l-690-691l90-90l691 690l691-690l90 90z" />
                </svg>


            </div>
        </div>
        <section class="lg:w-[57%]  w-full flex justify-center items-center md:h-full h-[45%] ">
            <img class="md:w-auto" src="man-entering-mobile-otp-illustration-svg-download-png-14848238.webp" alt="">
        </section>
        <section
            class="lg:w-[43%] w-full md:h-full md:bg-white lg:bg-fuchsia-200 bg-fuchsia-200 h-[55%] flex justify-center items-center ">
            <div
                class="border-2 flex gap-6  md:justify-center items-center max-md:py-10 flex-col md:border-none not-md:border-fuchsia-400 bg-white md:rounded-2xl xl:w-[80%] xl:min-h-[50%] lg:max-h-120  h-full md:h-[80%] w-full md:w-[83%]">
                <div class="lg:w-[70%] w-full flex flex-col justify-center gap-3.5 md:gap-2.5">
                    <h2 class="md:text-3xl text-4xl   max-md:text-center font-bold">OTP Verification</h2>

                    <p class="text-sm hidden text-center max-md:inline-block font-normal ">Enter the OTP Code sent to
                        <span id="maskedEmailDis" class="font-medium">Email****ddress</span>
                    </p>
                    <p class="text-lg md:block hidden font-normal ">Enter the 6-Digit code that was sent to your <span
                            class="font-medium">Email Address</span></p>
                </div>
                <form action="" id="verifyOTPform"
                    class="flex  px-[2%] w-full flex-col justify-center items-center gap-6">
                    <div class="flex justify-evenly md:justify-center items-center md:my-0 my-2 gap-3">
                        <input type="text" class="hidden" name="" id="otpValue">
                        <input
                            class="otp-input border-gray-400 border-2 md:h-13 md:w-12 h-13 w-[16%]  rounded-lg text-center bg-fuchsia-200 focus:bg-white focus:border-fuchsia-500 focus:outline-none text-xl font-medium focus:border-2"
                            type="text" maxlength="1" inputmode="numeric" data-index="1">
                        <input
                            class="otp-input border-gray-400 border-2 md:h-13 md:w-12 h-13 w-[16%] rounded-lg text-center bg-fuchsia-200 focus:bg-white focus:border-fuchsia-500 focus:outline-none text-xl font-medium focus:border-2"
                            type="text" maxlength="1" inputmode="numeric" data-index="1">
                        <input
                            class="otp-input border-gray-400 border-2 md:h-13 md:w-12 h-13 w-[16%] rounded-lg text-center bg-fuchsia-200 focus:bg-white focus:border-fuchsia-500 focus:outline-none text-xl font-medium focus:border-2"
                            type="text" maxlength="1" inputmode="numeric" data-index="1">
                        <input
                            class="otp-input border-gray-400 border-2 md:h-13 md:w-12 h-13 w-[16%] rounded-lg text-center bg-fuchsia-200 focus:bg-white focus:border-fuchsia-500 focus:outline-none text-xl font-medium focus:border-2"
                            type="text" maxlength="1" inputmode="numeric" data-index="1">
                        <input
                            class="otp-input border-gray-400 border-2 md:h-13 md:w-12 h-13 w-[16%] rounded-lg text-center bg-fuchsia-200 focus:bg-white focus:border-fuchsia-500 focus:outline-none text-xl font-medium focus:border-2"
                            type="text" maxlength="1" inputmode="numeric" data-index="1">
                        <input
                            class="otp-input border-gray-400 border-2 md:h-13 md:w-12 h-13 w-[16%] rounded-lg text-center bg-fuchsia-200 focus:bg-white focus:border-fuchsia-500 focus:outline-none text-xl font-medium focus:border-2"
                            type="text" maxlength="1" inputmode="numeric" data-index="1">
                    </div>
                    <div class="w-full flex justify-center items-center">
                        <button
                            class="capitalize h-14 my-4 md:my-0 md:h-11 md:w-[70%] w-[93%] active:scale-90 duration-200 transition-all bg-fuchsia-500 shadow-inner shadow-fuchsia-700 md:rounded-xl rounded-4xl text-lg font-semibold text-white">verify
                            & procced</button>
                    </div>
                </form>
                <form id="resendCode" class="flex justify-center gap-2.5">
                    <p>Didn't receive the code?</p> <button type="submit" id="resendCodeBtn"
                        class="active:scale-90 transition-all duration-200 text-fuchsia-600 font-medium">Resend
                        again</button>
                </form>
            </div>
        </section>

    </main>


    <script>
        const messageBox = document.getElementById('messageBox')
        const messageText = document.getElementById('messageText')
        const messageTextCont = document.getElementById('messageTextCont')
        const closeToastError = document.getElementById('closeToastError')
        const resendCode = document.getElementById('resendCode')
        const resendCodeBtn = document.getElementById('resendCodeBtn')
        const otpBoxes = document.querySelectorAll('.otp-input')
        const maskedEmailDis = document.getElementById('maskedEmailDis')






        window.addEventListener('pageshow', () => {
            otpBoxes.forEach(function (box, index) {
                box.classList.remove('otpBoxSuccess', 'scaleUp')

            })
        })

        function maskEmail(email) {
            if (!email || !email.includes('@')) return email
            const [local, domain] = email.split('@')
            if (local.length <= 6) {
                return `${local.slice(0, 3)}***@${domain}`
            }
            const start = local.slice(0, 3)
            const end = local.slice(-3)
            return `${start}***${end}@${domain}`
        }
        let finalEmail = ''
        window.addEventListener('DOMContentLoaded', () => {
            const passEmail = new URLSearchParams(window.location.search).get('email')
            maskEmail(passEmail)
            console.log(passEmail)
            finalEmail = (maskEmail(passEmail))
            maskedEmailDis.textContent = finalEmail

        })




        otpBoxes.forEach(function (box, index) {
            box.addEventListener('input', function (e) {
                this.value = this.value
                    .replace(/\D/g, '')
                if (e.target.value !== '' && index < otpBoxes.length - 1) {
                    otpBoxes[index + 1].focus()
                }
            })

            box.addEventListener('keydown', function (e) {
                if (e.key === 'Backspace') {
                    if (box.value !== '') {
                        return
                    }
                    if (index > 0) {
                        e.preventDefault()
                        const prev = otpBoxes[index - 1]
                        prev.value = ''
                        prev.focus()
                    }
                }
            })

            box.addEventListener('paste', function (e) {
                e.preventDefault()
                const pasted = e.clipboardData.getData('text')
                const digits = pasted.replace(/\D/g, '')
                const code = digits.slice(0, 6)
                const chars = code.split('')
                if (chars.length === 0) {
                    return
                }

                otpBoxes.forEach(function (box) {
                    box.value = ''
                })
                chars.forEach(function (char, i) {
                    otpBoxes[i].value = char
                })
                const nextIndex = Math.min(chars.length, otpBoxes.length - 1)
                otpBoxes[nextIndex].focus()
            })
        })
        let verifyOTPform = document.getElementById('verifyOTPform')
        const svgToast = document.getElementById('svgToast')
        const svgToastGreen = document.getElementById('svgToastGreen')

        const otpValue = document.getElementById('otpValue')
        verifyOTPform.addEventListener('submit', async (event) => {
            event.preventDefault()
            let codeValue = ''
            otpBoxes.forEach(function (box) {
                codeValue += box.value
                otpValue.value = codeValue

            })
            // console.log(otpValue.value)
            const email = new URLSearchParams(window.location.search).get('email')

            const payLoad = {
                code: otpValue.value
            }
            const response = await fetch('/verify-otp-submit', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'

                },
                body: JSON.stringify(payLoad)

            })

            const errorJson = await response.json()
            if (!response.ok) {
                messageBox.classList.replace('tran', 'translate-x-0')
                // messageTextCont.classList.remove('bg-green-600', 'shadow-green-600')
                messageBox.classList.replace('border-green-800', 'border-red-800')
                messageTextCont.classList.add('bg-red-500', 'shadow-red-600')
                messageTextCont.classList.remove('bg-green-500', 'shadow-green-600')
                svgToast.classList.replace('hidden', 'block')
                svgToastGreen.classList.replace('block', 'hidden')
                closeToastError.classList.replace('hover:bg-green-400', 'hover:bg-red-400')

                closeToast()
                const clearmessage = errorJson.error || errorJson.errors[0].replace(/['"]/g, '')
                messageText.innerText = clearmessage
            }
            if (response.status === 422) {
                otpBoxes.forEach(function (box, index) {
                    const delay = (otpBoxes.length - 1 - index) * 50
                    setTimeout(() => {
                        box.classList.add('shake2')
                        box.value = ''
                        setTimeout(() => {
                            box.classList.remove('shake2')
                        }, 300)
                    }, delay)
                })

                const totalTime = otpBoxes.length * 50 + 100
                setTimeout(() => {
                    otpBoxes[0].focus()
                }, totalTime)

            }
            if (response.ok) {
                otpBoxes.forEach((box, i) => {
                    box.classList.remove('otpBoxSuccess', 'scaleUp')

                    setTimeout(() => {

                        box.classList.add('otpBoxSuccess', 'scaleUp')
                    }, i * 70)
                    setTimeout(() => {
                        window.location = `/create-new-password?email=${email}&code=${otpValue.value}`

                    }, 590)
                })
            }
        })

        closeToastError.addEventListener('click', () => {
            messageBox.classList.replace('translate-x-0', 'tran')

        })
        function closeToast() {
            setTimeout(() => {
                messageBox.classList.replace('translate-x-0', 'tran')
            }, 4000)
        }

        resendCode.addEventListener('submit', async (event) => {
            //         if (!navigator.onLine) {
            //     messageBox.classList.replace('tran', 'translate-x-0')
            //     closeToast()
            //    messageText.innerText = 'Network error. Check your connection and try again.'
            //    return
            // } 
            event.preventDefault()
            const email = new URLSearchParams(window.location.search).get('email')
            const payload = {
                email: email
            }
            const res = await fetch('/resend-code-post', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(payload)
            })
            const errorJson = await res.json()
            if (!res.ok) {
                messageBox.classList.replace('tran', 'translate-x-0')
                messageBox.classList.replace('border-green-800', 'border-red-800')
                messageTextCont.classList.add('bg-red-500', 'shadow-red-600')
                messageTextCont.classList.remove('bg-green-500', 'shadow-green-600')
                svgToast.classList.replace('hidden', 'block')
                svgToastGreen.classList.replace('block', 'hidden')
                closeToastError.classList.replace('hover:bg-green-400', 'hover:bg-red-400')

                // messageTextCont.classList.remove('bg-green-600', 'shadow-green-600')
                closeToast()
                const clearmessage = errorJson.error || errorJson.errors[0].replace(/['"]/g, '')
                messageText.innerText = clearmessage
            }
            if (res.ok) {
                messageBox.classList.replace('tran', 'translate-x-0')
                messageBox.classList.replace('border-red-800', 'border-green-800')
                messageTextCont.classList.remove('bg-red-500', 'shadow-red-600')
                messageTextCont.classList.add('bg-green-500', 'shadow-green-600')
                svgToast.classList.replace('block', 'hidden')
                svgToastGreen.classList.replace('hidden', 'block')
                closeToastError.classList.replace('hover:bg-red-400', 'hover:bg-green-400')

                closeToast()
                const clearmessage = errorJson.message
                messageText.innerText = clearmessage
            }
        })


    </script>
</body>

</html>